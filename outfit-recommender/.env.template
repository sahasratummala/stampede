# Environment Variables Template
# Copy this to .env.local and fill in your API keys

# OpenAI API Key (for Vision analysis)
OPENAI_API_KEY=your_openai_api_key_here

# SerpAPI Key (for outfit ideas and artist info)
SERPAPI_KEY=your_serpapi_key_here

# OpenWeather API Key (for Austin weather)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Optional: Database connection (for storing user preferences)
DATABASE_URL=your_database_url_here

# Optional: Authentication
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000

# Microsoft OAuth (for UT email verification)
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=common
